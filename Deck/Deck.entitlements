<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Raise the jetsam kill ceiling for the 2.5GB resident model.
	     Note: sideloading tools may strip this if the provisioning profile
	     doesn't authorize it — the unload-on-background half still saves us. -->
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
</dict>
</plist>
